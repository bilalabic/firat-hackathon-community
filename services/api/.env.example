# Copy to services/api/.env (gitignored) and fill in. Never commit real values.

# Postgres as the admin_backend role. Local stack (pnpm db:start):
DATABASE_URL=postgresql://admin_backend:admin_backend_local_dev@127.0.0.1:54322/postgres
# Cloud (M7): session pooler, user admin_backend.<project-ref>, ?sslmode=require

# Shared with apps/admin/.env.local. At least 32 characters, e.g.:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_TOKEN=replace-with-a-random-token-of-at-least-32-characters

# Public-site revalidation. Leave both empty to disable it.
WEB_BASE_URL=
WEB_REVALIDATE_SECRET=

# Local LLM. Defaults shown; the model is a placeholder until the V1.2 benchmark.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:0.8b
OLLAMA_TIMEOUT_S=120

# Telegram. Leave empty until the bot and channel exist (the check reports not_configured).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Telegram admin bot (V1.1b): a SEPARATE bot for review/application decisions. Disabled by
# default; a bad value only disables the bot (GET /admin-bot/status shows why).
# User ids are numeric (not usernames): run `uv run python -m fhc_api.admin_bot.whoami`.
TELEGRAM_ADMIN_ENABLED=false
TELEGRAM_ADMIN_BOT_TOKEN=
TELEGRAM_ADMIN_USER_IDS=
# Optional. Defaults shown: buttons older than 12 h are refused (a fresh message follows);
# the outbox scans every 60 s.
# TELEGRAM_ADMIN_MAX_PRESS_AGE_H=12
# TELEGRAM_ADMIN_SCAN_INTERVAL_S=60

# Optional. JSON list; the default is ["127.0.0.1","localhost"].
# ALLOWED_HOSTS=["127.0.0.1","localhost"]
