# Copy to apps/admin/.env.local (gitignored) and fill in. Never commit real values.
# Read only on the server (lib/api/client.ts); never prefix these with NEXT_PUBLIC_.

# FastAPI admin API (services/api), bound to 127.0.0.1.
ADMIN_API_URL=http://127.0.0.1:8000
# Must equal ADMIN_API_TOKEN in services/api/.env (at least 32 characters).
ADMIN_API_TOKEN=replace-with-the-same-token-as-services-api

# Optional. Host names (optionally host:port) the admin answers to; anything else gets
# 400 (DNS-rebinding protection, src/proxy.ts). Default: 127.0.0.1,localhost
# ADMIN_ALLOWED_HOSTS=127.0.0.1,localhost
