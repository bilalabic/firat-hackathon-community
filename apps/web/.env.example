# Public website (apps/web). Copy to .env.local for local development. Never commit real values.
# Local values: `pnpm exec supabase status -o json` (API_URL, PUBLISHABLE_KEY).

# Server-only. No NEXT_PUBLIC_ prefix, so neither value is bundled for the browser.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Bearer token FastAPI sends to POST /api/revalidate.
WEB_REVALIDATE_SECRET=change-me
# Bearer token Vercel Cron sends to GET /api/cron/keep-alive (set automatically on Vercel).
CRON_SECRET=change-me

# Absolute site URL for canonical links, sitemap and OpenGraph (no trailing slash).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
